# Copy this file to .env in your project or ~/.config/shot-analysis-cli/.env.
# Add only the keys you intend to use. Never commit the filled file.
SHOT_ANALYSIS_PROVIDER=gemini

GEMINI_MODEL=gemini-3.5-flash
ANTHROPIC_MODEL=claude-sonnet-5-5
DEEPSEEK_MODEL=deepseek-v4-flash

SHOT_ANALYSIS_PROMPT_PREFIX=DY,
SHOT_ANALYSIS_TIMEOUT_MS=180000
SHOT_ANALYSIS_RETRY_ATTEMPTS=4
SHOT_ANALYSIS_MAX_OUTPUT_TOKENS=32768

GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
