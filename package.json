{
  "name": "shot-analysis-cli",
  "version": "0.1.0",
  "description": "Interactive CLI for turning a video brief into an approved story, shot list, and generation prompt.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alekpr/shot-analysis-cli.git"
  },
  "homepage": "https://github.com/alekpr/shot-analysis-cli#readme",
  "bugs": "https://github.com/alekpr/shot-analysis-cli/issues",
  "type": "module",
  "bin": {
    "shot-analysis": "./bin/shot-analysis.js"
  },
  "scripts": {
    "start": "node ./bin/shot-analysis.js",
    "test": "node --test",
    "check": "node ./scripts/check-syntax.js",
    "pack:check": "npm pack --dry-run"
  },
  "files": [
    ".env.example",
    "LICENSE",
    "README.md",
    "bin/",
    "docs/",
    "scripts/",
    "src/"
  ],
  "engines": {
    "node": ">=20.17"
  },
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^8.7.4"
  }
}
